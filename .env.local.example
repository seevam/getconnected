# Email configuration (copy this file to .env.local and fill in your values)
# Without these, forms still work — submissions are logged to the server console instead.

# SMTP server settings (Gmail example below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password   # Gmail: Settings > Security > App Passwords

# "From" address shown in email client (defaults to SMTP_USER if not set)
SMTP_FROM=ConnectED <your-gmail@gmail.com>

# Where story submissions and Spotify requests are sent
CONTACT_EMAIL=shivam.ascendnow@gmail.com
